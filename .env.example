# Copiați acest fișier în .env și completați valorile. .env nu se urcă pe GitHub.
# Variabilele de mediu cu același nume au prioritate față de .env.
# Același fișier e citit de aplicație și de `docker compose` (care creează contul de mai jos).
ECOSORT_DB_HOST=127.0.0.1
# Schimbați portul dacă 3306 e ocupat de un MySQL instalat local (ex. 3310).
ECOSORT_DB_PORT=3306
ECOSORT_DB_NAME=ecosort
ECOSORT_DB_USER=ecosort_app
# Minim 8 caractere.
ECOSORT_DB_PASSWORD=
